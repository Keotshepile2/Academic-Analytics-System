# ============================================
# EXISTING SMS DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=student_record_system

# ============================================
# APA-DSS READ-ONLY DATABASE CONFIGURATION
# ============================================
# Use a dedicated read-only user for analytics
# Create this user with: GRANT SELECT ON student_record_system.* TO 'apa_dss_user'@'localhost';
APA_DSS_DB_HOST=localhost
APA_DSS_DB_PORT=3306
APA_DSS_DB_USER=apa_dss_user
APA_DSS_DB_PASSWORD=change_this_password
APA_DSS_DB_NAME=student_record_system

# ============================================
# SESSION CONFIGURATION
# ============================================
# IMPORTANT: Change this to a strong secret in production
# Generate a random string: openssl rand -base64 32
SESSION_SECRET=change_this_to_a_strong_secret_key
# Session timeout in milliseconds (1 hour = 3600000, 8 hours = 28800000)
SESSION_MAX_AGE=3600000

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# CORS Configuration (for development)
CORS_ORIGIN=http://localhost:3000

# ============================================
# MACHINE LEARNING CONFIGURATION (Phase 7)
# ============================================
# Path to Python ML scripts
ML_SCRIPT_PATH=./ml-pipeline
# Python virtual environment path (optional)
PYTHON_ENV_PATH=./ml-pipeline/venv

# ============================================
# API CONFIGURATION (Future Phases)
# ============================================
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=60000